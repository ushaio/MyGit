<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="MyGit"
        Arguments=""
        InstallLocation="C:\Program Files\MyGit\MyGit">
    </Installer>
    <PackageInformation
        PackageName="MyGit"
        PackageDisplayName="MyGit"
        PublisherName="CN=MyGit"
        PublisherDisplayName="MyGit"
        Version="0.1.0.0"
        PackageDescription="A worktree-centered Git workspace">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="app.mygit.desktop"
                Description="A worktree-centered Git workspace"
                DisplayName="MyGit"
                ExecutableName="MyGit"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>MyGit</DisplayName>
            <PublisherDisplayName>MyGit</PublisherDisplayName>
            <Description>A worktree-centered Git workspace</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="mygit.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
